{
  "name": "dsh-auto-review-model-select",
  "version": "0.1.0",
  "description": "Route DeepSeek Harness Auto review to a chosen model and normalize its decision output.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "auto-review",
    "model",
    "approval"
  ],
  "homepage": "https://github.com/GT-610/dsh-auto-review-model-select#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GT-610/dsh-auto-review-model-select.git"
  },
  "bugs": "https://github.com/GT-610/dsh-auto-review-model-select/issues",
  "author": "GT610 (https://github.com/GT-610)",
  "license": "MIT",
  "private": true,
  "icon": "./icon.svg",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.2-rc.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": "./dist/client.cjs",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "tsdown && node --test \"tests/*.test.mjs\"",
    "check:bundle": "node scripts/check-client-purity.mjs",
    "check:locale": "node scripts/check-locale.mjs",
    "check": "tsc --noEmit && oxlint && tsdown && node --test \"tests/*.test.mjs\" && node scripts/check-client-purity.mjs && node scripts/check-locale.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/node": "^22.15.0",
    "@types/react": "~18.3.1",
    "oxlint": "^1.93.0",
    "react": "^18.3.1",
    "react-test-renderer": "18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  }
}
